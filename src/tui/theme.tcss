/* RETRO ARCADE / TERMINAL GAME THEME */
Screen {
    background: #09090b;
    color: #00ff41;
}

Header {
    background: #ff007f;
    color: #ffffff;
    text-style: bold;
}

HeaderClock {
    background: #ff007f;
    color: #ffffff;
}

#main-split {
    layout: horizontal;
    min-width: 50;
}

/* Responsivitas - Scrollable Vertical Container jika layar terlalu pendek */
#left-panel {
    width: 35%;
    min-width: 35;
    height: 100%;
    border: heavy #00ffff;
    padding: 1;
    background: #050510;
}

#right-panel {
    width: 65%;
    height: 100%;
    border: heavy #ff007f;
    background: #050510;
}

StatusBox {
    border: panel #00ff41;
    padding: 1 2;
    margin-bottom: 2;
    height: auto;
    color: #00ff41;
    background: #001100;
}

.main-status {
    border: double #ff007f;
    color: #ff007f;
    text-align: center;
}

QRDisplay {
    min-height: 15;
    border: heavy #ffea00;
    content-align: center middle;
    background: #000000;
    color: #ffffff;
    margin-bottom: 2;
}

Button {
    width: 100%;
    margin-bottom: 1;
    border: tall #00ffff;
    background: #002244;
    color: #00ffff;
    text-style: bold;
}

Button:hover {
    background: #00ffff;
    color: #000000;
}

#btn-reset {
    border: tall #ff0000;
    background: #440000;
    color: #ff0000;
}

#btn-reset:hover {
    background: #ff0000;
    color: #ffffff;
}

/* Memperbaiki Tab Container agar mengisi layar dan flex-grow */
TabbedContent {
    height: 100%;
}

/* Tab Panel content area */
TabPane {
    height: 100%;
    padding: 0;
}

.log-viewer {
    height: 100%;
    border: blank;
    background: #020202;
    color: #00ff41;
}
